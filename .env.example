# BookHaven — example environment configuration
# Copy this file to ".env" and fill in real values. Never commit .env.

# Port the server listens on (Render/Railway/Fly set this automatically)
PORT=3000

# production/development. In production the server refuses to start without
# ADMIN_EMAIL and ADMIN_PASSWORD (they never fall back to code defaults).
NODE_ENV=development

# Public URL of the live site, e.g. https://bookhaven.onrender.com
# Shown in frontend error banners instead of a hardcoded localhost address.
SITE_URL=

# Path to the SQLite database file (development default)
# DB_PATH=./books.db

# Supabase (hosted PostgreSQL) — RECOMMENDED for the live site.
# Leave DATABASE_URL empty (or remove the line) to keep using the local
# SQLite file — the app auto-detects either one and works the same.
# To switch to Supabase:
#   1. Create a project at https://supabase.com
#   2. Run supabase/schema.sql once: dashboard -> SQL Editor -> Run.
#      The 5,720-book catalogue and the admin account then seed themselves
#      on the first app start.
#   3. Copy the connection string:
#      dashboard -> Project Settings -> Database -> Connection string.
#      For server-to-server access prefer the "Session pooler" URI
#      (port 5432). The app also adds the required TLS automatically.
# DATABASE_URL=

# Email + password used to create the admin account (only on first run).
# REQUIRED in production — set them as secrets in the host dashboard.
ADMIN_EMAIL=ebubegift4199@gmail.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=BookHaven Admin

# How long a session token stays valid (days)
SESSION_TTL_DAYS=30

# CORS: leave empty for same-origin. When the frontend (e.g. a static host)
# is served from a different domain than the API, set this to the site URL,
# e.g. CORS_ORIGIN=https://bookhaven.example.com  (or * to allow any)
CORS_ORIGIN=

# Where uploaded cover images are stored on the server
# UPLOAD_DIR=./uploads

# Contact "Send Message" form
# Every message is saved in the database and shown in Admin -> Messages.
# To ALSO forward each message to your inbox, fill in SMTP below. With Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=youraccount@gmail.com
#   SMTP_PASS=<Gmail App Password>   (see Google -> Security -> App passwords)
# Leave SMTP_USER empty to skip email forwarding entirely.
CONTACT_RECIPIENT=Bookhaven41@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# CONTACT_FROM=BookHaven <noreply@yourdomain.com>

# Social sign-in (OAuth 2.0). Register a free app at each provider and paste
# the credentials. Any provider left blank is hidden from the account page.
# You must whitelist the exact callback URLs below in each developer console
# (SITE_URL = this site's public address, http://localhost:3000 in dev):
#   Google:    <SITE_URL>/api/auth/google/callback
#   Facebook:  <SITE_URL>/api/auth/facebook/callback
#   Instagram: <SITE_URL>/api/auth/instagram/callback
# Google  -> https://console.cloud.google.com -> APIs & Services -> Credentials
#            (OAuth client ID, "Web application"). Needs BOTH ID and secret.
# Facebook-> https://developers.facebook.com -> create app -> add "Facebook Login"
# Instagram -> https://developers.facebook.com -> Meta app with "Instagram API
#            with Instagram Login with Instagram". Needs an Instagram
#            Business/Creator account linked to a Meta business portfolio and
#            App Review for public apps. Instagram does NOT return emails, so
#            Instagram accounts get a placeholder email after the handle.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=