# BookHaven — example environment configuration
# Copy this file to ".env" and fill in real values. Never commit .env.

# Port the server listens on (Render/Railway/Fly set this automatically)
PORT=3000

# production/development. In production the server refuses to start without
# ADMIN_EMAIL and ADMIN_PASSWORD (they never fall back to code defaults).
NODE_ENV=development

# Public URL of the live site, e.g. https://bookhaven.onrender.com
# Shown in frontend error banners instead of a hardcoded localhost address.
SITE_URL=

# Path to the SQLite database file
# DB_PATH=./books.db

# Email + password used to create the admin account (only on first run).
# REQUIRED in production — set them as secrets in the host dashboard.
ADMIN_EMAIL=ebubegift4199@gmail.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=BookHaven Admin

# How long a session token stays valid (days)
SESSION_TTL_DAYS=30

# CORS: leave empty for same-origin. When the frontend (e.g. a static host)
# is served from a different domain than the API, set this to the site URL,
# e.g. CORS_ORIGIN=https://bookhaven.example.com  (or * to allow any)
CORS_ORIGIN=

# Where uploaded cover images are stored on the server
# UPLOAD_DIR=./uploads