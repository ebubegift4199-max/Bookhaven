{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html",
          "favicon.ico",
          "css/**",
          "js/**",
          "assets/**",
          "img/**",
          "scripts/seed-data.json"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "server.js" }
  ],
  "functions": {
    "server.js": {
      "runtime": "nodejs22.x",
      "maxDuration": 60
    }
  }
}